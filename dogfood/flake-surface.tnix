let
  flake = import ../flake.nix;

  inputs :: ResolvedFlakeInputs;
  # The inputs are never evaluated here; `throw` stands in for each resolved
  # flake and takes whatever type the input declaration asks for.
  unevaluated = throw "dogfood: flake inputs are not evaluated";
  inputs = {
    self = unevaluated;
    nixpkgs = unevaluated;
    flake-utils = unevaluated;
  };

  outputs :: FlakeOutputs;
  outputs = flake.outputs inputs;
in {
  description = flake.description;
  nixpkgsUrl = flake.inputs.nixpkgs.url;
  formatter = outputs.formatter.aarch64-darwin;
  devShell = outputs.devShells.aarch64-darwin.default;
}
