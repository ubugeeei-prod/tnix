cabal-version:      3.8
name:               tnix-lsp
version:            0.5.0.0
build-type:         Simple
license:            MIT
license-file:       LICENSE
author:             tnix contributors
maintainer:         tnix contributors
homepage:           https://github.com/ubugeeei/tnix
bug-reports:        https://github.com/ubugeeei/tnix/issues
category:           Language
synopsis:           Minimal LSP server for tnix

library
  exposed-modules:
      AnalysisCache
    , Server
    , ServerProtocol
    , ServerUri
    , Session
    , SessionDiagnostics
    , SessionDocuments
    , SessionFolding
    , SessionInlayHints
    , SessionLinks
    , SessionReferences
    , SessionSemanticTokens
    , SessionSymbols
    , SessionText
    , SessionTypes
    , SessionWorkspace
  hs-source-dirs: src
  build-depends:
      aeson
    , base >=4.19 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , tnix-core
  default-language: GHC2021

executable tnix-lsp
  main-is: Main.hs
  hs-source-dirs: app
  other-modules:
      Paths_tnix_lsp
  build-depends:
      aeson
    , base >=4.19 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , text
    , tnix-lsp
    , tnix-core
  default-language: GHC2021

test-suite tnix-lsp-spec
  type: exitcode-stdio-1.0
  main-is: Server.spec.hs
  hs-source-dirs: src
  other-modules:
      Server
    , ServerProtocol
    , ServerUri
  build-depends:
      aeson
    , base >=4.19 && <5
    , bytestring
    , containers
    , directory
    , filepath
    , hspec
    , text
    , tnix-core
    , tnix-lsp
    , unix
  default-language: GHC2021

