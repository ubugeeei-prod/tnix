# Kitchen-sink sample exercising every syntactic form the grammar knows.
/* block
   comment */
type Option a = { _tag :: "some"; value :: a; } | { _tag :: "none"; };
type Element t = t extends List (infer a) ? a : dynamic;
type ReturnOf f = f extends (_ -> infer r) ? r : unknown;
type Shape = Tensor [2 (Range 1 2 Nat) 1] Int;
type Linear = Int %1 -> Int;
type Showable a = Show a => a -> String;
type Lit = "x" | 1 | 1.5 | true | false | -3;

declare "./legacy/default.nix" {
  default :: { value :: Int; "quoted-key" :: any; };
  mkPkg :: forall a b. { name :: String; } -> a -> b;
};

declare ./lib.nix { lib :: dynamic; };

{ pkgs ? import <nixpkgs> { }, lib, ... }@args:
let
  # @tnix-ignore
  value = missing;
  # @tnix-expected
  bad :: Int;
  bad = "oops";
  id :: forall a. a -> a;
  id = x: x;
  typed = (x :: Int): x + 1;
  named = args@{ a, b ? 2, }: a;
  str = "hello ${name} \n \${not} $${literal} $";
  ind = ''
    echo ${pkgs.hello}/bin/hello
    ''${escaped} '''quoted''' ''\n $
  '';
  paths = [ ./foo.nix ../bar/baz ./dir/${name}.nix /etc/hosts ~/.config <nixpkgs/lib> https://example.org/x?y=1 ];
  ops = !a && b || c -> d == e != f < g <= h > i >= j // k ++ l + m - n * o / p;
  neg = -1 - -2.5e3;
  pipe = xs |> map f <| ys;
  sel = a.b.${c}."d" or null;
  has = a ? b.c;
  cast = (f x) as { name :: String; } as unknown;
  rec' = rec { a = 1; b = a; };
  inherit (pkgs) stdenv fetchurl;
  inherit lib;
  nested.attr.path = 1;
  "quoted attr" = true;
  ${dyn} = 2;
in
assert value != null;
with lib;
if typed 1 > 0 then { inherit value; } else id bad
