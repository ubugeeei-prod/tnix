{
  "name": "tree-sitter-tnix",
  "version": "1.0.0",
  "description": "tree-sitter grammar for tnix (Nix with a gradual type layer)",
  "private": true,
  "license": "MIT",
  "keywords": [
    "tree-sitter",
    "nix",
    "tnix",
    "parser"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ubugeeei/tnix.git",
    "directory": "editors/tree-sitter-tnix"
  },
  "scripts": {
    "generate": "tree-sitter generate --no-bindings",
    "test": "tree-sitter test",
    "parse-corpus": "node scripts/parse-corpus.mjs",
    "sync-queries": "node scripts/sync-queries.mjs",
    "check-queries": "node scripts/sync-queries.mjs --check"
  },
  "tree-sitter": [
    {
      "scope": "source.tnix",
      "file-types": [
        "tnix"
      ],
      "injection-regex": "^tnix$",
      "highlights": "queries/highlights.scm",
      "injections": "queries/injections.scm",
      "locals": "queries/locals.scm"
    }
  ]
}
