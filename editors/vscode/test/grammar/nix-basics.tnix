# A plain Nix file: comments, literals, operators.
/* block
   comment */
/** Doc comment. TODO: more */
{ lib, stdenv ? null, ... }@args:
let
  answer = 42;
  ratio = 0.5e3;
  enabled = true && !false || null == null;
  merged = { a = 1; } // { b = 2; };
  joined = [ 1 2 ] ++ [ 3 ];
  piped = answer |> toString;
  implies = enabled -> enabled;
  has = args ? lib.version;
  fallback = args.missing or "default";
  nested.attr."quoted key".${answer} = 1;
  inherit (lib) mkIf optional;
  inherit answer;
  math = 1 + 2 - 3 * 4 / 5;
  cmp = 1 < 2 && 2 <= 3 && 3 > 2 && 3 >= 3 && 1 != 2;
  kebab-case' = answer;
in
assert answer > 0;
with lib;
rec {
  name = if enabled then "on" else "off";
  value = builtins.map (x: x * 2) [ 1 2 ];
  thrown = throw "nope";
  imported = import ./default.nix;
  formatted = lib.concatStringsSep ", " [ "a" ];
}
