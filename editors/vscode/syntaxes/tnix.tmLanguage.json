{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "tnix",
  "scopeName": "source.tnix",
  "fileTypes": [
    "tnix",
    "d.tnix",
    "nix"
  ],
  "patterns": [
    {
      "include": "#declaration"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "include": "#directive"
        },
        {
          "name": "comment.block.documentation.tnix",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.tnix"
            }
          },
          "patterns": [
            {
              "include": "#comment-annotations"
            }
          ]
        },
        {
          "name": "comment.block.tnix",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.tnix"
            }
          },
          "patterns": [
            {
              "include": "#comment-annotations"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.tnix",
          "begin": "#",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.tnix"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#comment-annotations"
            }
          ]
        }
      ]
    },
    "directive": {
      "comment": "`# @tnix-ignore` / `# @tnix-expected` suppress the next checker failure.",
      "match": "^\\s*(#)\\s*(@tnix-(?:ignore|expected))(?![A-Za-z0-9_'\\-])(.*)$",
      "name": "comment.line.number-sign.directive.tnix",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.tnix"
        },
        "2": {
          "name": "keyword.control.directive.tnix"
        }
      }
    },
    "comment-annotations": {
      "patterns": [
        {
          "match": "\\b(TODO|FIXME|XXX|HACK|NOTE|BUG)\\b",
          "name": "keyword.other.todo.tnix"
        }
      ]
    },
    "declaration": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#type-alias"
        },
        {
          "include": "#declare"
        }
      ]
    },
    "type-alias": {
      "comment": "type Name params = Type;",
      "name": "meta.type-alias.tnix",
      "begin": "(?<![A-Za-z0-9_'\\-.])(type)\\s+([A-Za-z_][A-Za-z0-9_'\\-]*)((?:\\s+[A-Za-z_][A-Za-z0-9_'\\-]*)*)\\s*(=)(?![=>])",
      "beginCaptures": {
        "1": {
          "name": "storage.type.type.tnix"
        },
        "2": {
          "name": "entity.name.type.alias.tnix"
        },
        "3": {
          "patterns": [
            {
              "match": "[A-Za-z_][A-Za-z0-9_'\\-]*",
              "name": "entity.name.type.parameter.tnix"
            }
          ]
        },
        "4": {
          "name": "keyword.operator.assignment.tnix"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.tnix"
        }
      },
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "declare": {
      "comment": "declare \"./file.nix\" { name :: Type; };",
      "name": "meta.declare.tnix",
      "begin": "(?<![A-Za-z0-9_'\\-.])(declare)(?![A-Za-z0-9_'\\-])(?=\\s*(?:\"|~?\\.{0,2}/|<|$))",
      "beginCaptures": {
        "1": {
          "name": "storage.modifier.declare.tnix"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.statement.tnix"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#string-double"
        },
        {
          "include": "#path"
        },
        {
          "name": "meta.declare.body.tnix",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.begin.tnix"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.end.tnix"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#signature"
            }
          ]
        }
      ]
    },
    "signature": {
      "comment": "name :: Type;  (let items, attribute sets, declare bodies)",
      "name": "meta.signature.tnix",
      "begin": "(?<![A-Za-z0-9_'\\-.])(?:([A-Za-z_][A-Za-z0-9_'\\-]*)|(\"(?:[^\"\\\\]|\\\\.)*\"))\\s*(::)(?!:)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.tnix"
        },
        "2": {
          "name": "string.quoted.double.tnix"
        },
        "3": {
          "name": "keyword.operator.type.annotation.tnix"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.signature.tnix"
        }
      },
      "patterns": [
        {
          "include": "#type"
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#signature"
        },
        {
          "include": "#binding-function"
        },
        {
          "include": "#binding"
        },
        {
          "include": "#string-indented"
        },
        {
          "include": "#string-double"
        },
        {
          "include": "#declaration"
        },
        {
          "include": "#typed-binder"
        },
        {
          "include": "#inherit"
        },
        {
          "include": "#with-assert"
        },
        {
          "include": "#cast"
        },
        {
          "include": "#type-annotation"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#uri"
        },
        {
          "include": "#path"
        },
        {
          "include": "#number"
        },
        {
          "include": "#constants"
        },
        {
          "include": "#builtins"
        },
        {
          "include": "#lambda-head"
        },
        {
          "include": "#braces"
        },
        {
          "include": "#brackets"
        },
        {
          "include": "#parens"
        },
        {
          "include": "#select"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#identifier"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(if|then|else)(?![A-Za-z0-9_'\\-])",
          "name": "keyword.control.conditional.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(assert)(?![A-Za-z0-9_'\\-])",
          "name": "keyword.control.assert.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(import)(?![A-Za-z0-9_'\\-])",
          "name": "keyword.control.import.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(let)(?![A-Za-z0-9_'\\-])",
          "name": "keyword.other.let.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(in)(?![A-Za-z0-9_'\\-])",
          "name": "keyword.other.in.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(with)(?![A-Za-z0-9_'\\-])",
          "name": "keyword.other.with.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(rec)(?![A-Za-z0-9_'\\-])",
          "name": "storage.modifier.rec.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(or)(?![A-Za-z0-9_'\\-])",
          "name": "keyword.operator.or.tnix"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(true)(?![A-Za-z0-9_'\\-])",
          "name": "constant.language.boolean.true.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(false)(?![A-Za-z0-9_'\\-])",
          "name": "constant.language.boolean.false.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(null)(?![A-Za-z0-9_'\\-])",
          "name": "constant.language.null.tnix"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(?:\\d+\\.\\d*|\\.\\d+)(?:[eE][+-]?\\d+)?(?![A-Za-z0-9_'.])",
          "name": "constant.numeric.float.tnix"
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])\\d+(?![A-Za-z0-9_'.])",
          "name": "constant.numeric.integer.tnix"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(builtins)(?:\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_'\\-]*))?(?![A-Za-z0-9_'\\-])",
          "captures": {
            "1": {
              "name": "variable.language.builtins.tnix"
            },
            "2": {
              "name": "punctuation.accessor.tnix"
            },
            "3": {
              "name": "support.function.builtin.tnix"
            }
          }
        },
        {
          "match": "(?<![A-Za-z0-9_'\\-.])(abort|baseNameOf|break|derivation|derivationStrict|dirOf|fetchGit|fetchMercurial|fetchTarball|fetchTree|fromTOML|isNull|map|placeholder|removeAttrs|scopedImport|throw|toString)(?![A-Za-z0-9_'\\-])",
          "name": "support.function.builtin.tnix"
        }
      ]
    },
    "identifier": {
      "match": "(?<![A-Za-z0-9_'\\-.])[A-Za-z_][A-Za-z0-9_'\\-]*",
      "name": "variable.other.readwrite.tnix"
    },
    "select": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_'\\-]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.tnix"
            },
            "2": {
              "name": "variable.other.property.tnix"
            }
          }
        },
        {
          "match": "\\.(?=\\s*(?:\"|\\$\\{))",
          "name": "punctuation.accessor.tnix"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "->",
          "name": "keyword.operator.logical.implication.tnix"
        },
        {
          "match": "\\|>|<\\|",
          "name": "keyword.operator.pipe.tnix"
        },
        {
          "match": "//",
          "name": "keyword.operator.update.tnix"
        },
        {
          "match": "\\+\\+",
          "name": "keyword.operator.concat.tnix"
        },
        {
          "match": "==|!=",
          "name": "keyword.operator.comparison.tnix"
        },
        {
          "match": "<=|>=|<|>",
          "name": "keyword.operator.relational.tnix"
        },
        {
          "match": "&&|\\|\\|",
          "name": "keyword.operator.logical.tnix"
        },
        {
          "match": "!",
          "name": "keyword.operator.logical.not.tnix"
        },
        {
          "match": "\\+|-|\\*|/",
          "name": "keyword.operator.arithmetic.tnix"
        },
        {
          "match": "\\?",
          "name": "keyword.operator.has-attr.tnix"
        },
        {
          "match": "=",
          "name": "keyword.operator.assignment.tnix"
        },
        {
          "match": "@",
          "name": "keyword.operator.at.tnix"
        },
        {
          "match": ":",
          "name": "storage.type.function.arrow.tnix"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.tnix"
        },
        {
          "match": ",",
          "name": "punctuation.separator.comma.tnix"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.tnix"
        }
      ]
    },
    "string-double": {
      "name": "string.quoted.double.tnix",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tnix"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tnix"
        }
      },
      "patterns": [
        {
          "match": "\\\\.",
          "name": "constant.character.escape.tnix"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "string-indented": {
      "name": "string.quoted.other.indented.tnix",
      "begin": "''",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.tnix"
        }
      },
      "end": "''(?!['$\\\\])",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.tnix"
        }
      },
      "patterns": [
        {
          "match": "''(?:\\$|'|\\\\.)",
          "name": "constant.character.escape.tnix"
        },
        {
          "include": "#interpolation"
        }
      ]
    },
    "interpolation": {
      "name": "meta.embedded.interpolation.tnix",
      "begin": "\\$\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.tnix"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.tnix"
        }
      },
      "contentName": "source.tnix",
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "uri": {
      "match": "(?<![A-Za-z0-9_'\\-.])[A-Za-z][A-Za-z0-9+\\-.]*:(?!:)[A-Za-z0-9%/?:@&=+$,\\-_.!~*']+",
      "name": "string.unquoted.uri.tnix"
    },
    "path": {
      "patterns": [
        {
          "comment": "<nixpkgs> search path",
          "match": "<[A-Za-z0-9._+\\-]+(?:/[A-Za-z0-9._+\\-]+)*>",
          "name": "string.unquoted.spath.tnix"
        },
        {
          "comment": "./foo/${bar}/baz — a path with interpolation",
          "name": "string.unquoted.path.tnix",
          "begin": "(?<![A-Za-z0-9._+\\-/'])(?:~|[A-Za-z0-9._+\\-]*)(?:/[A-Za-z0-9._+\\-]+)*/[A-Za-z0-9._+\\-]*(?=\\$\\{)",
          "end": "(?![A-Za-z0-9._+\\-]|/|\\$\\{)",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "match": "(?:[A-Za-z0-9._+\\-]|/)+"
            }
          ]
        },
        {
          "match": "(?<![A-Za-z0-9._+\\-/'])(?:~|[A-Za-z0-9._+\\-]*)(?:/[A-Za-z0-9._+\\-]+)+/?",
          "name": "string.unquoted.path.tnix"
        }
      ]
    },
    "binding-function": {
      "comment": "name = <lambda>; the key is highlighted as a function name.",
      "name": "meta.binding.tnix",
      "begin": "(?=(?<![A-Za-z0-9_'\\-.])(?:[A-Za-z_][A-Za-z0-9_'\\-]*|\"(?:[^\"\\\\]|\\\\.)*\"|\\$\\{(?:[^{}]|\\{[^{}]*\\})*\\})(?:\\s*\\.\\s*(?:[A-Za-z_][A-Za-z0-9_'\\-]*|\"(?:[^\"\\\\]|\\\\.)*\"|\\$\\{(?:[^{}]|\\{[^{}]*\\})*\\}))*\\s*=(?![=>])\\s*(?:[A-Za-z_][A-Za-z0-9_'\\-]*\\s*(?:@\\s*\\{|:(?![:A-Za-z0-9%/?@&=+$,_.!~*'\\-]))|\\{[^{}]*\\}\\s*(?:@\\s*[A-Za-z_][A-Za-z0-9_'\\-]*\\s*)?:(?![:A-Za-z0-9%/?@&=+$,_.!~*'\\-])|\\(\\s*[A-Za-z_][A-Za-z0-9_'\\-]*\\s*::))",
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.binding.tnix"
        }
      },
      "patterns": [
        {
          "begin": "\\G",
          "end": "=",
          "endCaptures": {
            "0": {
              "name": "keyword.operator.assignment.tnix"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#string-double"
            },
            {
              "include": "#interpolation"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_'\\-]*",
              "name": "entity.name.function.tnix"
            },
            {
              "match": "\\.",
              "name": "punctuation.accessor.tnix"
            }
          ]
        },
        {
          "include": "#expression"
        }
      ]
    },
    "binding": {
      "comment": "a.b.\"c\".${d} = value;",
      "name": "meta.binding.tnix",
      "begin": "(?=(?<![A-Za-z0-9_'\\-.])(?:[A-Za-z_][A-Za-z0-9_'\\-]*|\"(?:[^\"\\\\]|\\\\.)*\"|\\$\\{(?:[^{}]|\\{[^{}]*\\})*\\})(?:\\s*\\.\\s*(?:[A-Za-z_][A-Za-z0-9_'\\-]*|\"(?:[^\"\\\\]|\\\\.)*\"|\\$\\{(?:[^{}]|\\{[^{}]*\\})*\\}))*\\s*=(?![=>]))",
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.binding.tnix"
        }
      },
      "patterns": [
        {
          "begin": "\\G",
          "end": "=",
          "endCaptures": {
            "0": {
              "name": "keyword.operator.assignment.tnix"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#string-double"
            },
            {
              "include": "#interpolation"
            },
            {
              "match": "[A-Za-z_][A-Za-z0-9_'\\-]*",
              "name": "entity.other.attribute-name.tnix"
            },
            {
              "match": "\\.",
              "name": "punctuation.accessor.tnix"
            }
          ]
        },
        {
          "include": "#expression"
        }
      ]
    },
    "with-assert": {
      "comment": "`with e;` / `assert e;` own their `;` so it does not end an enclosing binding.",
      "patterns": [
        {
          "name": "meta.with.tnix",
          "begin": "(?<![A-Za-z0-9_'\\-.])(with)(?![A-Za-z0-9_'\\-])",
          "beginCaptures": {
            "1": {
              "name": "keyword.other.with.tnix"
            }
          },
          "end": ";",
          "endCaptures": {
            "0": {
              "name": "punctuation.terminator.with.tnix"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        },
        {
          "name": "meta.assert.tnix",
          "begin": "(?<![A-Za-z0-9_'\\-.])(assert)(?![A-Za-z0-9_'\\-])",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.assert.tnix"
            }
          },
          "end": ";",
          "endCaptures": {
            "0": {
              "name": "punctuation.terminator.assert.tnix"
            }
          },
          "patterns": [
            {
              "include": "#expression"
            }
          ]
        }
      ]
    },
    "inherit": {
      "name": "meta.inherit.tnix",
      "begin": "(?<![A-Za-z0-9_'\\-.])(inherit)(?![A-Za-z0-9_'\\-])",
      "beginCaptures": {
        "1": {
          "name": "keyword.other.inherit.tnix"
        }
      },
      "end": ";",
      "endCaptures": {
        "0": {
          "name": "punctuation.terminator.inherit.tnix"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#parens"
        },
        {
          "include": "#string-double"
        },
        {
          "match": "[A-Za-z_][A-Za-z0-9_'\\-]*",
          "name": "entity.other.attribute-name.tnix"
        }
      ]
    },
    "braces": {
      "comment": "Attribute sets and lambda formals `{ a, b ? 1, ... }@args` share one rule.",
      "name": "meta.braces.tnix",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.braces.begin.tnix"
        }
      },
      "end": "(\\})(?:\\s*(@)\\s*([A-Za-z_][A-Za-z0-9_'\\-]*))?",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.braces.end.tnix"
        },
        "2": {
          "name": "keyword.operator.at.tnix"
        },
        "3": {
          "name": "variable.parameter.tnix"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#formal"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "formal": {
      "patterns": [
        {
          "comment": "an item of a lambda formals list",
          "match": "(?:(?<=[{,])|^)\\s*(?!(?:inherit|let|in|if|then|else|with|assert|rec|or|import|true|false|null)(?![A-Za-z0-9_'\\-]))([A-Za-z_][A-Za-z0-9_'\\-]*)(?:\\s*(\\?)|(?=\\s*(?:,|\\}|$)))",
          "captures": {
            "1": {
              "name": "variable.parameter.tnix"
            },
            "2": {
              "name": "keyword.operator.default.tnix"
            }
          }
        },
        {
          "match": "\\.\\.\\.",
          "name": "keyword.operator.ellipsis.tnix"
        }
      ]
    },
    "lambda-head": {
      "patterns": [
        {
          "comment": "args@{ ... }",
