# Types for the NixOS / nix-darwin / home-manager module system.
#
# Alias-only; builds on `nixpkgs-lib.d.tnix` (which also defines
# `NixosSystemArgs` and `NixosConfiguration` for `lib.nixosSystem`) and
# `nixpkgs-pkgs.d.tnix`.
#
#   { config, lib :: NixpkgsLib, pkgs :: NixpkgsPkgs, ... }:
#   {
#     options.services.hello.enable = lib.mkEnableOption "hello";
#     config = lib.mkIf config.services.hello.enable { ... };
#   }
#
#   declare "./modules/hello.nix" { default :: NixosModule; };
#
# `config` and `options` are `dynamic`: their shape is the union of every
# module in the evaluation, which a declaration file cannot know.

# The arguments a module function receives. `specialArgs` / `_module.args`
# add more, so the record is open.
type NixosModuleArgs = {
  config :: dynamic;
  options :: dynamic;
  lib :: NixpkgsLib;
  pkgs :: NixpkgsPkgs;
  modulesPath :: Path;
  specialArgs? :: NixpkgsAttrs;
  name? :: String;
  ...
};

# The attribute-set form of a module. A set without `config`, `options` or
# `imports` is shorthand for `config`, so arbitrary option paths are allowed.
type NixosModuleAttrs = {
  imports? :: List dynamic;
  options? :: dynamic;
  config? :: dynamic;
  disabledModules? :: List dynamic;
  freeformType? :: NixpkgsOptionType dynamic;
  meta? :: {
    maintainers? :: List NixpkgsMaintainer;
    doc? :: Path;
    buildDocsInSandbox? :: Bool;
    ...
  };
  _file? :: String | Path;
  _class? :: String;
  key? :: String;
  ...
};

type NixosModuleFunction = NixosModuleArgs -> NixosModuleAttrs;

# Anything that may appear in `imports` / `modules`.
type NixosModule = NixosModuleAttrs | NixosModuleFunction | Path;

# Common, stable option values used in modules (`users.users.<name>`,
# `systemd.services.<name>`, `environment.systemPackages`, ...). These are
# conveniences for annotating your own helpers; module `config` is `dynamic`.
type NixosSystemdService = {
  description? :: String;
  wantedBy? :: List String;
  after? :: List String;
  before? :: List String;
  wants? :: List String;
  requires? :: List String;
  path? :: List NixpkgsBuildInput;
  environment? :: AttrsOf (String | Path | NixpkgsDerivationCore | Null);
  script? :: String;
  preStart? :: String;
  postStart? :: String;
  serviceConfig? :: NixpkgsAttrs;
  unitConfig? :: NixpkgsAttrs;
  restartTriggers? :: List dynamic;
  enable? :: Bool;
  ...
};

type NixosUser = {
  isNormalUser? :: Bool;
  isSystemUser? :: Bool;
  description? :: String;
  home? :: String | Path;
  createHome? :: Bool;
  group? :: String;
  extraGroups? :: List String;
  uid? :: Int | Null;
  shell? :: NixpkgsDerivationCore | String | Path | Null;
  packages? :: List NixpkgsBuildInput;
  openssh? :: { authorizedKeys? :: { keys? :: List String; keyFiles? :: List Path; ... }; ... };
  hashedPassword? :: String | Null;
  initialPassword? :: String | Null;
  ...
};
