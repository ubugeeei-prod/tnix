type NixpkgsConfig = {
  allowUnfree? :: Bool;
  allowUnfreePredicate? :: NixpkgsDerivationCore -> Bool;
  allowBroken? :: Bool;
  allowUnsupportedSystem? :: Bool;
  allowInsecurePredicate? :: NixpkgsDerivationCore -> Bool;
  permittedInsecurePackages? :: List String;
  allowAliases? :: Bool;
  cudaSupport? :: Bool;
  rocmSupport? :: Bool;
  packageOverrides? :: dynamic -> NixpkgsAttrs;
  ...
};

type NixpkgsPkgs = {
  lib :: NixpkgsLib;
  stdenv :: NixpkgsStdenv;
  stdenvNoCC :: NixpkgsStdenv;
  system :: String;
  buildPlatform :: NixpkgsPlatform;
  hostPlatform :: NixpkgsPlatform;
  targetPlatform :: NixpkgsPlatform;
  config :: NixpkgsConfig;
  overlays :: List NixpkgsOverlay;
  runtimeShell :: String;

  # Package-set plumbing. Variants of the set itself are `dynamic` to keep the
  # alias graph acyclic.
  callPackage :: NixpkgsCallPackage;
  callPackages :: NixpkgsCallPackage;
  newScope :: NixpkgsAttrs -> NixpkgsCallPackage;
  extend :: NixpkgsOverlay -> dynamic;
  appendOverlays :: List NixpkgsOverlay -> dynamic;
  recurseIntoAttrs :: forall r. { ...r } -> { ...r };
  pkgsCross :: AttrsOf dynamic;
  pkgsStatic :: dynamic;
  pkgsMusl :: dynamic;
  pkgsLLVM :: dynamic;
  pkgsi686Linux :: dynamic;
  pkgsBuildBuild :: dynamic;
  pkgsBuildHost :: dynamic;
  pkgsHostTarget :: dynamic;
  buildPackages :: dynamic;
  legacyPackages :: dynamic;

  # Fetchers.
  fetchurl :: NixpkgsFetchUrl;
  fetchzip :: NixpkgsFetchZip;
  fetchgit :: NixpkgsFetchGit;
  fetchFromGitHub :: NixpkgsFetchFromGitHub;
  fetchFromGitLab :: NixpkgsFetchFromGitLab;
  fetchFromGitea :: NixpkgsFetchFromForgeArgs -> NixpkgsDerivation;
  fetchFromCodeberg :: NixpkgsFetchFromForgeArgs -> NixpkgsDerivation;
  fetchFromSourcehut :: NixpkgsFetchFromForgeArgs -> NixpkgsDerivation;
  fetchFromBitbucket :: NixpkgsFetchFromForgeArgs -> NixpkgsDerivation;
  fetchpatch :: NixpkgsFetchPatch;
  fetchpatch2 :: NixpkgsFetchPatch;
  fetchCrate :: NixpkgsFetchCrateArgs -> NixpkgsDerivation;
  fetchPypi :: NixpkgsFetchPypiArgs -> NixpkgsDerivation;
  fetchNpmDeps :: NixpkgsAttrs -> NixpkgsDerivation;
  fetchPnpmDeps :: NixpkgsAttrs -> NixpkgsDerivation;
  fetchYarnDeps :: NixpkgsAttrs -> NixpkgsDerivation;

  # Trivial builders.
  writeText :: String -> String -> NixpkgsDerivation;
  writeTextDir :: String -> String -> NixpkgsDerivation;
  writeTextFile :: NixpkgsWriteTextFileArgs -> NixpkgsDerivation;
  writeScript :: String -> String -> NixpkgsDerivation;
  writeScriptBin :: String -> String -> NixpkgsDerivation;
  writeShellScript :: String -> String -> NixpkgsDerivation;
  writeShellScriptBin :: String -> String -> NixpkgsDerivation;
  writeShellApplication :: NixpkgsWriteShellApplicationArgs -> NixpkgsDerivation;
  writeCBin :: String -> String -> NixpkgsDerivation;
  writeClosure :: List NixpkgsDerivationCore -> NixpkgsDerivation;
  writeReferencesToFile :: NixpkgsSourceLike -> NixpkgsDerivation;
  writeDirectReferencesToFile :: NixpkgsSourceLike -> NixpkgsDerivation;
  writeStringReferencesToFile :: String -> NixpkgsDerivation;
  concatText :: String -> List NixpkgsSourceLike -> NixpkgsDerivation;
  concatScript :: String -> List NixpkgsSourceLike -> NixpkgsDerivation;
  concatTextFile :: NixpkgsConcatTextFileArgs -> NixpkgsDerivation;
  runCommand :: NixpkgsRunCommand;
  runCommandLocal :: NixpkgsRunCommand;
  runCommandCC :: NixpkgsRunCommand;
  runCommandNoCC :: NixpkgsRunCommand;
  runCommandWith :: NixpkgsRunCommandWithArgs -> String -> NixpkgsDerivation;
  symlinkJoin :: NixpkgsSymlinkJoinArgs -> NixpkgsDerivation;
  buildEnv :: NixpkgsBuildEnvArgs -> NixpkgsDerivation;
  linkFarm :: String -> AttrsOf NixpkgsSourceLike | List { name :: String; path :: NixpkgsSourceLike; } -> NixpkgsDerivation;
  linkFarmFromDrvs :: String -> List NixpkgsDerivationCore -> NixpkgsDerivation;
  onlyBin :: NixpkgsDerivationCore -> NixpkgsDerivation;
  makeSetupHook :: NixpkgsMakeSetupHookArgs -> Path | String -> NixpkgsDerivation;
  applyPatches :: NixpkgsApplyPatchesArgs -> NixpkgsDerivation;
  requireFile :: NixpkgsRequireFileArgs -> NixpkgsDerivation;
  copyPathToStore :: Path -> NixpkgsDerivation;
  copyPathsToStore :: List Path -> List NixpkgsDerivation;
  replaceVars :: NixpkgsSourceLike -> AttrsOf (String | Path | NixpkgsDerivationCore | Null) -> NixpkgsDerivation;
  substituteAll :: NixpkgsAttrs -> NixpkgsDerivation;
  srcOnly :: NixpkgsAttrs -> NixpkgsDerivation;
  emptyFile :: NixpkgsDerivation;
  emptyDirectory :: NixpkgsDerivation;
  mkShell :: NixpkgsMkShellArgs -> NixpkgsDerivation;
  mkShellNoCC :: NixpkgsMkShellArgs -> NixpkgsDerivation;
  formats :: NixpkgsFormats;
  writers :: NixpkgsWriters;
  testers :: NixpkgsAttrs;
  nixosTest :: dynamic -> NixpkgsDerivation;
  dockerTools :: NixpkgsDockerTools;

  # Language ecosystems.
  buildGoModule :: NixpkgsArgsOrFinalAttrs NixpkgsBuildGoModuleArgs -> NixpkgsDerivation;
  rustPlatform :: NixpkgsRustPlatform;
  buildNpmPackage :: NixpkgsArgsOrFinalAttrs NixpkgsBuildNpmPackageArgs -> NixpkgsDerivation;
  importNpmLock :: dynamic;
  python3 :: NixpkgsPython;
  python3Packages :: NixpkgsPythonPackages;
  haskellPackages :: NixpkgsHaskellPackageSet;
  haskell :: {
    packages :: AttrsOf NixpkgsHaskellPackageSet;
    compiler :: AttrsOf NixpkgsDerivation;
    lib :: NixpkgsAttrs;
    ...
  };
  nodePackages :: NixpkgsAttrs;
  perlPackages :: NixpkgsAttrs;
  rubyPackages :: NixpkgsAttrs;
  ocamlPackages :: NixpkgsAttrs;
  vimPlugins :: AttrsOf NixpkgsPackage;
  darwin :: NixpkgsAttrs;
  xorg :: NixpkgsAttrs;

  # Frequently used packages and build hooks. Any other attribute is `dynamic`.
  alejandra :: NixpkgsPackage;
  autoconf :: NixpkgsPackage;
  automake :: NixpkgsPackage;
  autoPatchelfHook :: NixpkgsPackage;
  bash :: NixpkgsPackage;
  bashInteractive :: NixpkgsPackage;
  bun :: NixpkgsPackage;
  cabal-install :: NixpkgsPackage;
  cacert :: NixpkgsPackage;
  cargo :: NixpkgsPackage;
  clang :: NixpkgsPackage;
  clang-tools :: NixpkgsPackage;
  clippy :: NixpkgsPackage;
  cmake :: NixpkgsPackage;
  coreutils :: NixpkgsPackage;
  curl :: NixpkgsPackage;
  deadnix :: NixpkgsPackage;
  deno :: NixpkgsPackage;
  direnv :: NixpkgsPackage;
  docker :: NixpkgsPackage;
  fd :: NixpkgsPackage;
  findutils :: NixpkgsPackage;
  fourmolu :: NixpkgsPackage;
  fzf :: NixpkgsPackage;
  gawk :: NixpkgsPackage;
  gcc :: NixpkgsPackage;
  gh :: NixpkgsPackage;
  ghc :: NixpkgsPackage;
  git :: NixpkgsPackage;
  glibc :: NixpkgsPackage;
  gnugrep :: NixpkgsPackage;
  gnumake :: NixpkgsPackage;
  gnused :: NixpkgsPackage;
  gnutar :: NixpkgsPackage;
  go :: NixpkgsPackage;
  gopls :: NixpkgsPackage;
  gradle :: NixpkgsPackage;
  gzip :: NixpkgsPackage;
  haskell-language-server :: NixpkgsPackage;
  hello :: NixpkgsPackage;
  hlint :: NixpkgsPackage;
  installShellFiles :: NixpkgsPackage;
  jdk :: NixpkgsPackage;
  jq :: NixpkgsPackage;
  just :: NixpkgsPackage;
  libiconv :: NixpkgsPackage;
  libtool :: NixpkgsPackage;
  llvm :: NixpkgsPackage;
  makeBinaryWrapper :: NixpkgsPackage;
  makeWrapper :: NixpkgsPackage;
  maven :: NixpkgsPackage;
  meson :: NixpkgsPackage;
  neovim :: NixpkgsPackage;
  nil :: NixpkgsPackage;
  ninja :: NixpkgsPackage;
  nix :: NixpkgsPackage;
  nixd :: NixpkgsPackage;
  nixfmt :: NixpkgsPackage;
  nixfmt-rfc-style :: NixpkgsPackage;
  nodejs :: NixpkgsPackage;
  nodejs_20 :: NixpkgsPackage;
  nodejs_22 :: NixpkgsPackage;
  nodejs_24 :: NixpkgsPackage;
  openssl :: NixpkgsPackage;
  ormolu :: NixpkgsPackage;
  perl :: NixpkgsPackage;
  pkg-config :: NixpkgsPackage;
  pnpm :: NixpkgsPackage;
  postgresql :: NixpkgsPackage;
  pre-commit :: NixpkgsPackage;
  protobuf :: NixpkgsPackage;
  python3Minimal :: NixpkgsPackage;
  redis :: NixpkgsPackage;
  ripgrep :: NixpkgsPackage;
  ruby :: NixpkgsPackage;
  rust-analyzer :: NixpkgsPackage;
  rustc :: NixpkgsPackage;
  rustfmt :: NixpkgsPackage;
  shellcheck :: NixpkgsPackage;
  shfmt :: NixpkgsPackage;
  sqlite :: NixpkgsPackage;
  statix :: NixpkgsPackage;
  tmux :: NixpkgsPackage;
  treefmt :: NixpkgsPackage;
  typescript :: NixpkgsPackage;
  unzip :: NixpkgsPackage;
  wget :: NixpkgsPackage;
  which :: NixpkgsPackage;
  xz :: NixpkgsPackage;
  yarn :: NixpkgsPackage;
  zig :: NixpkgsPackage;
  zlib :: NixpkgsPackage;
  zstd :: NixpkgsPackage;
  ...
};

type NixpkgsImport = NixpkgsImportArgs -> NixpkgsPkgs;
