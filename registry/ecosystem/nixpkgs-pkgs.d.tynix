  env? :: AttrsOf (String | Int | Bool | Path | NixpkgsDerivationCore);
  meta? :: NixpkgsMeta;
  passthru? :: NixpkgsAttrs;
  pos? :: { file :: String; line :: Int; column :: Int; };
