# Types for the nixpkgs package set (`pkgs`, `import <nixpkgs> { ... }`).
#
# Alias-only, like `nixpkgs-lib.d.tynix` (which this pack builds on; load the
# whole `registry/ecosystem/` directory). Connect it to your code with an
# annotation or a `declare` block:
#
#   { pkgs :: NixpkgsPkgs, ... }: pkgs.writeShellScriptBin "hi" "echo hi"
#   { stdenv :: NixpkgsStdenv, fetchFromGitHub :: NixpkgsFetchFromGitHub, ... }: ...
#   declare "./nix/pkgs.nix" { default :: NixpkgsPkgs; };
#
# `NixpkgsPkgs` is open: packages that are not listed are `dynamic`.
# Argument records are closed but every field is optional (`name? :: T`), so a
# misspelled *type* is caught (`doCheck = "yes"`) and missing *required*
# fields are reported (`fetchFromGitHub { repo = ...; }` without `owner`).
# Extra attributes are still accepted, as they are by nixpkgs.

# Anything that can appear in `buildInputs` and friends.
type NixpkgsBuildInput = NixpkgsDerivationCore | Path | String;

type NixpkgsPackage = NixpkgsDerivation;

# `final: prev: { ... }`.
type NixpkgsOverlay = dynamic -> dynamic -> dynamic;

# Builders that accept either an argument set or `finalAttrs: { ... }`.
type NixpkgsArgsOrFinalAttrs a = a | (dynamic -> a);

# --- Argument records (generated field lists; all fields optional) ---------

# `stdenv.mkDerivation { ... }`. Extra attributes (custom env vars, flags)
# are allowed by width subtyping and passed through to the builder.
type NixpkgsMkDerivationArgs = {
  pname? :: String;
  version? :: String;
