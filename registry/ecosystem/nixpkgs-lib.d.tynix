  concatAttrValues :: forall a. AttrsOf (List a) -> List a;
  concatLists :: forall a. List (List a) -> List a;
  concatMap :: forall a b. (a -> List b) -> List a -> List b;
  count :: forall a. (a -> Bool) -> List a -> Int;
  crossLists :: dynamic -> List (List dynamic) -> List dynamic;
  drop :: forall a. Int -> List a -> List a;
  dropEnd :: forall a. Int -> List a -> List a;
  elem :: forall a. a -> List a -> Bool;
  elemAt :: forall a. List a -> Int -> a;
  filter :: forall a. (a -> Bool) -> List a -> List a;
