# Types for nixpkgs `lib` (https://github.com/NixOS/nixpkgs/tree/master/lib).
#
# This pack is alias-only: it declares *types*, not files. Connect it to a
# value with your own `declare` block or annotation, for example
#
#   declare "./nix/lib.nix" { default :: NixpkgsLib; };
#   { lib :: NixpkgsLib, ... }: lib.mapAttrs (name: value: value + 1) { a = 1; }
#
# Every sub-library is available both nested (`lib.attrsets.mapAttrs`) and at
# the top level (`lib.mapAttrs`), matching what nixpkgs re-exports. All library
# records are open (`...`), so members that are not listed here are `dynamic`
# instead of an error. Signatures follow nixpkgs 26.11; `dynamic` is used only
# where a member is genuinely untypable (deep recursion, overloads on runtime
# shape, module-system internals).
#
# This file is self-contained. The other packs in `registry/ecosystem/` build
# on it (`nixpkgs-pkgs`, `nixos-modules`, `flake-ecosystem`, ...), so load the
# whole directory through `declarationPacks`.
#
# Checker notes that shaped these signatures:
# - Aliases must not form cycles through more than one field (e.g. a package
#   set containing itself twice): recursive aliases are unrolled eagerly, so a
#   branching cycle explodes. That is why `override`, `pkgsStatic`, `extend`
#   and friends return `NixpkgsDerivationCore` / `dynamic`.
# - Option types carry their value type in the *contravariant* `check` field,
#   so `mkOption { type = types.int; default = "x"; }` is rejected while
#   `default = 8080` is accepted (the default may be a literal subtype).

# --- Basic shapes ------------------------------------------------------------

# Any attribute set. Fields selected from it are `dynamic`.
type NixpkgsAttrs = { ... };

# Systems nixpkgs builds for. Positions that *produce* a system use this union;
# positions that *accept* one take `String` so `builtins.currentSystem` works.
type NixpkgsSystem =
  "x86_64-linux"
  | "aarch64-linux"
  | "x86_64-darwin"
  | "aarch64-darwin"
  | "armv6l-linux"
  | "armv7l-linux"
  | "i686-linux"
  | "powerpc64le-linux"
  | "riscv64-linux"
  | "x86_64-freebsd";

type NixpkgsNameValuePair a = {
  name :: String;
  value :: a;
};

type NixpkgsPredicate a = a -> Bool;
type NixpkgsMapper a b = a -> b;
type NixpkgsNamedMapper a b = String -> a -> b;
type NixpkgsFolder a b = a -> b -> a;

# `final: prev: { ... }` — overlays, scope extensions, `lib.extends`.
type NixpkgsExtension = dynamic -> dynamic -> NixpkgsAttrs;

type NixpkgsFileType = "directory" | "regular" | "symlink" | "unknown";

# --- Licenses, maintainers, meta ---------------------------------------------

type NixpkgsLicense = {
  shortName :: String;
  fullName? :: String;
  spdxId? :: String;
  url? :: String;
  free? :: Bool;
  redistributable? :: Bool;
  deprecated? :: Bool;
  ...
};

type NixpkgsMaintainer = {
  name? :: String;
  email? :: String;
  github? :: String;
  githubId? :: Int;
  matrix? :: String;
  keys? :: List { fingerprint :: String; };
  ...
};

type NixpkgsTeam = {
  members :: List NixpkgsMaintainer;
  scope? :: String;
  shortName? :: String;
  githubTeams? :: List String;
  ...
};

type NixpkgsMeta = {
  description? :: String;
  longDescription? :: String;
  homepage? :: String | List String;
  downloadPage? :: String;
  changelog? :: String | List String;
  license? :: NixpkgsLicense | List NixpkgsLicense | String;
  maintainers? :: List NixpkgsMaintainer;
  teams? :: List NixpkgsAttrs;
  mainProgram? :: String;
  platforms? :: List (String | NixpkgsAttrs);
  badPlatforms? :: List (String | NixpkgsAttrs);
  hydraPlatforms? :: List (String | NixpkgsAttrs);
  broken? :: Bool;
  priority? :: Int;
  outputsToInstall? :: List String;
  knownVulnerabilities? :: List String;
  sourceProvenance? :: List NixpkgsAttrs;
  pkgConfigModules? :: List String;
  position? :: String;
  available? :: Bool;
  unfree? :: Bool;
  insecure? :: Bool;
  timeout? :: Int;
  ...
};

# --- Platforms and derivations -----------------------------------------------

# `stdenv.hostPlatform`, `lib.systems.elaborate "x86_64-linux"`, ...
type NixpkgsPlatform = {
  system :: String;
  config :: String;
  parsed :: dynamic;
  libc :: String;
  linker :: String;
  isLinux :: Bool;
  isDarwin :: Bool;
  isFreeBSD :: Bool;
  isOpenBSD :: Bool;
  isWindows :: Bool;
  isCygwin :: Bool;
  isUnix :: Bool;
  isMacOS :: Bool;
  isiOS :: Bool;
  isAndroid :: Bool;
  isWasm :: Bool;
  isWasi :: Bool;
  isAarch64 :: Bool;
  isAarch32 :: Bool;
  isAarch :: Bool;
  isx86_64 :: Bool;
  isx86_32 :: Bool;
  isx86 :: Bool;
  isRiscV :: Bool;
  isRiscV64 :: Bool;
  isPower64 :: Bool;
  isMips :: Bool;
  isLoongArch64 :: Bool;
  is64bit :: Bool;
  is32bit :: Bool;
  isMusl :: Bool;
  isGnu :: Bool;
  isStatic :: Bool;
  isLittleEndian :: Bool;
  isBigEndian :: Bool;
  uname :: {
    system :: String | Null;
    processor :: String;
    release :: String | Null;
  };
  extensions :: {
    sharedLibrary :: String;
    staticLibrary :: String;
    library :: String;
    executable :: String;
    ...
  };
  darwinMinVersion? :: String;
  darwinSdkVersion? :: String;
  emulator :: dynamic;
  canExecute :: dynamic;
  emulatorAvailable :: dynamic;
  rust :: dynamic;
  ...
};

# The fields every derivation-shaped value has; what builder inputs accept and
# what `override*` return. Deliberately small (no `meta`): it is expanded
# wherever it is used, and other fields are still reachable as `dynamic`.
type NixpkgsDerivationCore = {
  type :: "derivation";
  name :: String;
  outPath :: String;
  drvPath :: String;
  pname? :: String;
  version? :: String;
  ...
};

# A package from nixpkgs or `stdenv.mkDerivation`.
type NixpkgsDerivation = {
  type :: "derivation";
  name :: String;
  outPath :: String;
  drvPath :: String;
  system :: String;
  outputName :: String;
  outputs :: List String;
  pname? :: String;
  version? :: String;
  meta :: NixpkgsMeta;
  passthru? :: NixpkgsAttrs;
  drvAttrs :: NixpkgsAttrs;
  override :: dynamic -> NixpkgsDerivationCore;
  overrideAttrs :: dynamic -> NixpkgsDerivationCore;
  overrideDerivation :: (NixpkgsAttrs -> NixpkgsAttrs) -> NixpkgsDerivationCore;
  ...
};

# What `src`, `patches` and friends accept: a path, a store-path string, a
# fetcher result, or a `lib.sources` / `lib.fileset.toSource` value.
type NixpkgsSourceLike = Path | String | { outPath :: String | Path; ... };

type NixpkgsCleanSource = {
  outPath :: String | Path;
  origSrc :: Path;
  filter :: String -> String -> Bool;
  name :: String;
  ...
};

type NixpkgsFileset = {
  _type :: "fileset";
  ...
};
type NixpkgsFilesetLike = NixpkgsFileset | Path;
type NixpkgsFilesetFile = {
  name :: String;
  type :: NixpkgsFileType;
  hasExt :: String -> Bool;
  ...
};

# `lib.makeExtensible` / `lib.makeScope` results.
type NixpkgsExtensible = {
  extend :: NixpkgsExtension -> NixpkgsAttrs;
  __unfix__ :: dynamic;
  ...
};

type NixpkgsScope = {
  callPackage :: dynamic -> NixpkgsAttrs -> dynamic;
  callPackages :: dynamic -> NixpkgsAttrs -> dynamic;
  newScope :: NixpkgsAttrs -> dynamic -> NixpkgsAttrs -> dynamic;
  overrideScope :: NixpkgsExtension -> NixpkgsAttrs;
  packages :: dynamic;
  ...
};

type NixpkgsExtendMkDerivationArgs = {
  constructDrv :: dynamic;
  extendDrvArgs :: dynamic -> dynamic -> NixpkgsAttrs;
  excludeDrvArgNames? :: List String;
  excludeFunctionArgNames? :: List String;
  inheritFunctionArgs? :: Bool;
  transformDrv? :: dynamic;
};

# --- Module system -----------------------------------------------------------

# An option type such as `lib.types.str`. The parameter is the type of values
# the option holds; it lives in `check` so it is contravariant (see header).
type NixpkgsOptionType a = {
  _type :: "option-type";
  name :: String;
  description :: String | Null;
  descriptionClass :: String | Null;
  check :: a -> Bool;
  merge :: dynamic;
  emptyValue :: dynamic;
  getSubOptions :: dynamic;
  getSubModules :: dynamic;
  substSubModules :: dynamic;
  typeMerge :: dynamic;
  functor :: dynamic;
  nestedTypes :: dynamic;
  deprecationMessage :: String | Null;
};

type NixpkgsMkOptionTypeArgs a = {
  name :: String;
  description? :: String | Null;
  descriptionClass? :: String | Null;
  check? :: a -> Bool;
  merge? :: dynamic;
  emptyValue? :: dynamic;
  getSubOptions? :: dynamic;
  getSubModules? :: dynamic;
  substSubModules? :: dynamic;
  typeMerge? :: dynamic;
  functor? :: dynamic;
  nestedTypes? :: dynamic;
  deprecationMessage? :: String | Null;
};

# `lib.literalExpression "pkgs.hello"`, `lib.literalMD "..."`.
type NixpkgsLiteral = {
  _type :: "literalExpression" | "literalMD" | "literalCode";
  text :: String;
  ...
};

type NixpkgsMkOptionArgs a = {
  type? :: NixpkgsOptionType a;
  default? :: a;
  defaultText? :: String | NixpkgsLiteral;
  example? :: dynamic;
  description? :: String | NixpkgsLiteral;
  relatedPackages? :: List dynamic;
  apply? :: a -> dynamic;
  internal? :: Bool;
  visible? :: Bool | "shallow" | "transparent";
  readOnly? :: Bool;
};

# The value `mkOption` returns (an option declaration).
type NixpkgsOption a = {
  _type :: "option";
  type? :: NixpkgsOptionType a;
  default? :: a;
  description? :: String | NixpkgsLiteral;
  ...
};

type NixpkgsMkPackageOptionArgs = {
  nullable? :: Bool;
  default? :: String | List String | Null;
  example? :: String | List String | Null;
  extraDescription? :: String;
  pkgsText? :: String;
};

type NixpkgsOptionDefinition = {
  file :: String | Path;
  value :: dynamic;
  ...
};

type NixpkgsSubmoduleWithArgs = {
  modules :: List dynamic;
  specialArgs? :: NixpkgsAttrs;
  shorthandOnlyDefinesConfig? :: Bool;
  description? :: String | Null;
  class? :: String | Null;
};

type NixpkgsIntOptionTypes = {
  between :: Int -> Int -> NixpkgsOptionType Int;
  unsigned :: NixpkgsOptionType Int;
  positive :: NixpkgsOptionType Int;
  u8 :: NixpkgsOptionType Int;
  u16 :: NixpkgsOptionType Int;
  u32 :: NixpkgsOptionType Int;
  s8 :: NixpkgsOptionType Int;
  s16 :: NixpkgsOptionType Int;
  s32 :: NixpkgsOptionType Int;
  ...
};

type NixpkgsNumberOptionTypes = {
  between :: Number -> Number -> NixpkgsOptionType Number;
  nonnegative :: NixpkgsOptionType Number;
  positive :: NixpkgsOptionType Number;
  ...
};

# Values produced by `mkIf`, `mkMerge`, `mkOverride` (`mkDefault`, `mkForce`),
# `mkOrder` (`mkBefore`, `mkAfter`) and `mkDefinition`.
type NixpkgsModuleIf a = {
  _type :: "if";
  condition :: Bool;
  content :: a;
};
type NixpkgsModuleMerge a = {
  _type :: "merge";
  contents :: List a;
};
type NixpkgsModuleOverride a = {
  _type :: "override";
  priority :: Int;
  content :: a;
};
type NixpkgsModuleOrder a = {
  _type :: "order";
  priority :: Int;
  content :: a;
};
type NixpkgsModuleDefinition a = {
  _type :: "definition";
  file :: String | Path;
  value :: a;
};

# What `mkRenamedOptionModule` and friends return: a module function.
type NixpkgsModuleFunction = NixpkgsAttrs -> NixpkgsAttrs;

type NixpkgsDoRenameArgs = {
  from :: List String;
  to :: List String;
  visible :: Bool;
  warn :: Bool;
  use :: dynamic -> dynamic;
  withPriority? :: Bool;
  condition? :: Bool;
};

type NixpkgsEvalModulesArgs = {
  modules :: List dynamic;
  specialArgs? :: NixpkgsAttrs;
  class? :: String | Null;
  prefix? :: List String;
  args? :: NixpkgsAttrs;
  check? :: Bool;
};

type NixpkgsEvalModulesResult = {
  config :: dynamic;
  options :: dynamic;
  type :: NixpkgsOptionType dynamic;
  extendModules :: dynamic -> NixpkgsAttrs;
  _module :: dynamic;
  _type :: "configuration";
  class :: String | Null;
  ...
};

type NixpkgsSystemDoubles = {
  all :: List String;
  linux :: List String;
  darwin :: List String;
  freebsd :: List String;
  unix :: List String;
  windows :: List String;
  x86_64 :: List String;
  aarch64 :: List String;
  ...
};

# `nixpkgs.lib.nixosSystem { ... }`.
type NixosSystemArgs = {
  system? :: String | Null;
  modules :: List dynamic;
  specialArgs? :: NixpkgsAttrs;
  pkgs? :: dynamic;
  lib? :: dynamic;
  extraModules? :: List dynamic;
  baseModules? :: List dynamic;
  modulesLocation? :: Path | Null;
  prefix? :: List String;
};

# The result of `nixosSystem` / `darwinSystem` / `homeManagerConfiguration`.
type NixosConfiguration = {
  _type :: "configuration";
  config :: dynamic;
  options :: dynamic;
  pkgs :: dynamic;
  extendModules :: dynamic -> dynamic;
  type :: NixpkgsOptionType dynamic;
  class :: String | Null;
  _module :: dynamic;
  ...
};

# --- Sub-libraries -----------------------------------------------------------

# lib.trivial: combinators, booleans, warnings, version info
type NixpkgsTrivialLib = {
  add :: Int -> Int -> Int;
  and :: Bool -> Bool -> Bool;
  bitAnd :: Int -> Int -> Int;
  bitNot :: Int -> Int;
  bitOr :: Int -> Int -> Int;
  bitXor :: Int -> Int -> Int;
  boolToString :: Bool -> String;
  boolToYesNo :: Bool -> String;
  ceil :: Number -> Int;
  checkListOfEnum :: forall a b. String -> List a -> List a -> b -> b;
  codeName :: String;
  compare :: forall a. a -> a -> Int;
  concat :: forall a. List a -> List a -> List a;
  const :: forall a b. a -> b -> a;
  deepSeq :: forall a b. a -> b -> b;
  defaultTo :: forall a. a -> a | Null -> a;
  div :: Int -> Int -> Int;
  flip :: forall a b c. (a -> b -> c) -> b -> a -> c;
  floor :: Number -> Int;
  fromHexString :: String -> Int;
  functionArgs :: unknown -> AttrsOf Bool;
  genericClosure :: dynamic -> List dynamic;
  id :: forall a. a -> a;
  importJSON :: Path -> dynamic;
  importTOML :: Path -> dynamic;
  info :: forall a. String -> a -> a;
  inNixShell :: Bool;
  inPureEvalMode :: Bool;
  isBool :: unknown -> Bool;
  isFloat :: unknown -> Bool;
  isFunction :: unknown -> Bool;
  isInOldestRelease :: Int -> Bool;
  isInt :: unknown -> Bool;
  lessThan :: forall a. a -> a -> Bool;
  mapNullable :: forall a b. (a -> b) -> a | Null -> b | Null;
  max :: forall a. a -> a -> a;
  mergeAttrs :: NixpkgsAttrs -> NixpkgsAttrs -> NixpkgsAttrs;
  min :: forall a. a -> a -> a;
  mirrorFunctionArgs :: dynamic -> dynamic -> dynamic;
  mod :: Int -> Int -> Int;
  mul :: Int -> Int -> Int;
  nixpkgsVersion :: String;
  oldestSupportedRelease :: Int;
  oldestSupportedReleaseIsAtLeast :: Int -> Bool;
  "or" :: Bool -> Bool -> Bool;
  pathExists :: Path | String -> Bool;
  pipe :: forall a. a -> List dynamic -> dynamic;
  readFile :: Path | String -> String;
  release :: String;
  revisionWithDefault :: String -> String;
  seq :: forall a b. a -> b -> b;
  setFunctionArgs :: dynamic -> AttrsOf Bool -> dynamic;
  showWarnings :: forall a. List String -> a -> a;
  splitByAndCompare :: forall a. (a -> Bool) -> (a -> a -> Int) -> (a -> a -> Int) -> a -> a -> Int;
  sub :: Int -> Int -> Int;
  throwIf :: forall a. Bool -> String -> a -> a;
  throwIfNot :: forall a. Bool -> String -> a -> a;
  toBaseDigits :: Int -> Int -> List Int;
  toFunction :: dynamic -> dynamic;
  toHexString :: Int -> String;
  version :: String;
  versionSuffix :: String;
  warn :: forall a. String -> a -> a;
  warnIf :: forall a. Bool -> String -> a -> a;
  warnIfNot :: forall a. Bool -> String -> a -> a;
  xor :: Bool -> Bool -> Bool;
  ...
};

# lib.fixedPoints: fix, extends, makeExtensible
type NixpkgsFixedPointsLib = {
  composeExtensions :: NixpkgsExtension -> NixpkgsExtension -> NixpkgsExtension;
  composeManyExtensions :: List NixpkgsExtension -> NixpkgsExtension;
  converge :: forall a. (a -> a) -> a -> a;
  extends :: NixpkgsExtension -> (NixpkgsAttrs -> NixpkgsAttrs) -> NixpkgsAttrs -> NixpkgsAttrs;
  fix :: forall a. (a -> a) -> a;
  fix' :: (dynamic -> NixpkgsAttrs) -> NixpkgsAttrs;
  makeExtensible :: (NixpkgsAttrs -> NixpkgsAttrs) -> NixpkgsExtensible;
  makeExtensibleWithCustomName :: String -> (NixpkgsAttrs -> NixpkgsAttrs) -> NixpkgsAttrs;
  toExtension :: dynamic -> NixpkgsExtension;
  ...
};

# lib.attrsets: attribute set helpers
type NixpkgsAttrsetsLib = {
  attrByPath :: forall a. List String -> a -> NixpkgsAttrs -> dynamic;
  attrNames :: forall a. AttrsOf a -> List String;
  attrsToList :: forall a. AttrsOf a -> List (NixpkgsNameValuePair a);
  attrVals :: forall a. List String -> AttrsOf a -> List a;
  attrValues :: forall a. AttrsOf a -> List a;
  cartesianProduct :: forall a. AttrsOf (List a) -> List (AttrsOf a);
  catAttrs :: String -> List NixpkgsAttrs -> List dynamic;
  chooseDevOutputs :: List NixpkgsDerivationCore -> List NixpkgsDerivationCore;
  collect :: (dynamic -> Bool) -> NixpkgsAttrs -> List dynamic;
  concatMapAttrs :: forall a. (String -> a -> NixpkgsAttrs) -> AttrsOf a -> NixpkgsAttrs;
  dontRecurseIntoAttrs :: forall r. { ...r } -> { ...r };
  filterAttrs :: forall a. (String -> a -> Bool) -> AttrsOf a -> AttrsOf a;
  filterAttrsRecursive :: (String -> dynamic -> Bool) -> NixpkgsAttrs -> NixpkgsAttrs;
  foldAttrs :: forall a b. (a -> b -> b) -> b -> List (AttrsOf a) -> AttrsOf b;
  foldlAttrs :: forall acc a. (acc -> String -> a -> acc) -> acc -> AttrsOf a -> acc;
  genAttrs :: forall a. List String -> (String -> a) -> AttrsOf a;
  genAttrs' :: forall a b. List a -> (a -> NixpkgsNameValuePair b) -> AttrsOf b;
  getAttr :: String -> NixpkgsAttrs -> dynamic;
  getAttrFromPath :: List String -> NixpkgsAttrs -> dynamic;
  getAttrs :: forall a. List String -> AttrsOf a -> AttrsOf a;
  getBin :: NixpkgsDerivationCore -> NixpkgsDerivationCore;
  getDev :: NixpkgsDerivationCore -> NixpkgsDerivationCore;
  getFirstOutput :: List String -> NixpkgsDerivationCore -> NixpkgsDerivationCore;
  getInclude :: NixpkgsDerivationCore -> NixpkgsDerivationCore;
  getLib :: NixpkgsDerivationCore -> NixpkgsDerivationCore;
  getMan :: NixpkgsDerivationCore -> NixpkgsDerivationCore;
  getOutput :: String -> NixpkgsDerivationCore -> NixpkgsDerivationCore;
  getStatic :: NixpkgsDerivationCore -> NixpkgsDerivationCore;
  hasAttr :: String -> NixpkgsAttrs -> Bool;
  hasAttrByPath :: List String -> NixpkgsAttrs -> Bool;
  intersectAttrs :: NixpkgsAttrs -> NixpkgsAttrs -> NixpkgsAttrs;
  isAttrs :: unknown -> Bool;
  isDerivation :: unknown -> Bool;
  listToAttrs :: forall a. List (NixpkgsNameValuePair a) -> AttrsOf a;
  longestValidPathPrefix :: List String -> dynamic -> List String;
  mapAttrs :: forall a b. (String -> a -> b) -> AttrsOf a -> AttrsOf b;
  mapAttrs' :: forall a b. (String -> a -> NixpkgsNameValuePair b) -> AttrsOf a -> AttrsOf b;
  mapAttrsRecursive :: (List String -> dynamic -> dynamic) -> NixpkgsAttrs -> NixpkgsAttrs;
  mapAttrsRecursiveCond :: (NixpkgsAttrs -> Bool) -> (List String -> dynamic -> dynamic) -> NixpkgsAttrs -> NixpkgsAttrs;
  mapAttrsToList :: forall a b. (String -> a -> b) -> AttrsOf a -> List b;
  mapAttrsToListRecursive :: forall b. (List String -> dynamic -> b) -> NixpkgsAttrs -> List b;
  mapAttrsToListRecursiveCond :: forall b. (List String -> NixpkgsAttrs -> Bool) -> (List String -> dynamic -> b) -> NixpkgsAttrs -> List b;
  mapCartesianProduct :: forall a b. (AttrsOf a -> b) -> AttrsOf (List a) -> List b;
  matchAttrs :: NixpkgsAttrs -> NixpkgsAttrs -> Bool;
  mergeAttrsList :: List NixpkgsAttrs -> NixpkgsAttrs;
  nameValuePair :: forall a. String -> a -> NixpkgsNameValuePair a;
  optionalAttrs :: forall r. Bool -> { ...r } -> { ...r };
  overrideExisting :: forall r. { ...r } -> NixpkgsAttrs -> { ...r };
  recurseIntoAttrs :: forall r. { ...r } -> { ...r };
  recursiveUpdate :: NixpkgsAttrs -> NixpkgsAttrs -> NixpkgsAttrs;
  recursiveUpdateUntil :: (List String -> dynamic -> dynamic -> Bool) -> NixpkgsAttrs -> NixpkgsAttrs -> NixpkgsAttrs;
  removeAttrs :: NixpkgsAttrs -> List String -> NixpkgsAttrs;
  setAttrByPath :: forall a. List String -> a -> NixpkgsAttrs;
  showAttrPath :: List String -> String;
  toDerivation :: Path | String -> NixpkgsDerivationCore;
  unionOfDisjoint :: NixpkgsAttrs -> NixpkgsAttrs -> NixpkgsAttrs;
  updateManyAttrsByPath :: List { path :: List String; update :: dynamic -> dynamic; } -> NixpkgsAttrs -> NixpkgsAttrs;
  zipAttrs :: forall a. List (AttrsOf a) -> AttrsOf (List a);
  zipAttrsWith :: forall a b. (String -> List a -> b) -> List (AttrsOf a) -> AttrsOf b;
  zipAttrsWithNames :: forall a b. List String -> (String -> List a -> b) -> List (AttrsOf a) -> AttrsOf b;
  ...
};

# lib.lists: list helpers
