  fold :: forall a b. (a -> b -> b) -> b -> List a -> b;
  foldl :: forall a b. (b -> a -> b) -> b -> List a -> b;
  foldl' :: forall a b. (b -> a -> b) -> b -> List a -> b;
  foldr :: forall a b. (a -> b -> b) -> b -> List a -> b;
  forEach :: forall a b. List a -> (a -> b) -> List b;
  genList :: forall a. (Int -> a) -> Int -> List a;
  groupBy :: forall a. (a -> String) -> List a -> AttrsOf (List a);
  groupBy' :: forall a b. (b -> a -> b) -> b -> (a -> String) -> List a -> AttrsOf b;
  hasPrefix :: forall a. List a -> List a -> Bool;
  head :: forall a. List a -> a;
  ifilter0 :: forall a. (Int -> a -> Bool) -> List a -> List a;
  imap0 :: forall a b. (Int -> a -> b) -> List a -> List b;
