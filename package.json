{
  "name": "tnix-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "vp run workspace:build",
    "check": "vp run workspace:check",
    "fmt": "vp run workspace:fmt",
    "test": "vp run test:haskell && pnpm --filter tnix test && vp run test:zed",
    "docs:build": "vp build --config vite.docs.config.ts",
    "docs:deploy": "pnpm --filter tnix-docs-site run deploy",
    "docs:preview": "pnpm --filter tnix-docs-site run preview",
    "docs:check-deploy": "pnpm --filter tnix-docs-site run check"
  },
  "devDependencies": {
    "@ox-content/vite-plugin": "2.36.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.21",
    "vite-plus": "^0.1.21"
  }
}
